      <edge source="paetongtarn_shinawatra" target="anutin_charnvirakul" id="paetongtarn_shinawatra__anutin_charnvirakul__26855a" weight="2">
        <attvalues>
          <attvalue for="5" value="CRITICISM" />
          <attvalue for="6" value="แพทองธาร ชินวัตร วิพากษ์วิจารณ์/ตรวจสอบท่าทีของ อนุทิน ชาญวีรกูล" />
          <attvalue for="7" value="-0.7" />
          <attvalue for="8" value="2026-08-28" />
          <attvalue for="9" value="2569 วงเงินไม่เกิน 400,000 ล้านบาท โดยเฉพาะในส่วนของแผนงานที่ 2 กรอบวงเงิน 200,000 ล้านบาท เพื่อปรับโครงสร้างและสร้างการเปลี่ยนผ่านด้านพลังงานของประเทศว่า ยืนยันว่ารัฐบาลภายใต้การนำของนายอนุทิน ชาญวีรกูล นายกรัฐมนตรี พร้อมเดินหน้าตามกรอบกฎหมาย รัฐบาล" />
        </attvalues>
      </edge>
      <edge source="paetongtarn_shinawatra" target="sirikanya_tansakun" id="paetongtarn_shinawatra__sirikanya_tansakun__140bb4" weight="1">
        <attvalues>
          <attvalue for="5" value="OPPOSITION" />
          <attvalue for="6" value="แพทองธาร ชินวัตร และ ศิริกัญญา ตันสกุล มีปฏิสัมพันธ์ในประเด็นการเมือง" />
          <attvalue for="7" value="-0.2" />
          <attvalue for="8" value="2026-08-09" />
          <attvalue for="9" value="POLITICS: ‘อนุทิน’ โพสต์ “ถ้ายังวิ่งชนกำแพงอยู่ มันก็เจ็บหัวอีก” หลัง ‘ศิริกัญญา’ เปิดใจสู้ปัญหาในพรรคเหมือนสู้กับกำแพง วันนี้ (9 ส.ค. 69) นายอนุทิน ชาญวีรกูล นายกรัฐมนตรี และรัฐมนตรีว่าการกระทรวงมหาดไทย โพสต์ข้อความผ่านเฟสบุ๊คระบุว่า “วิ่งหัวชนกำแพง" />
        </attvalues>
      </edge>
      <edge source="paetongtarn_shinawatra" target="natthaphong_ruengpanyawut" id="paetongtarn_shinawatra__natthaphong_ruengpanyawut__b56e6d" weight="1">
